{
  "name": "garmin-manager",
  "description": "Manage music, podcasts, audiobooks and maps on Garmin watches from the browser",
  "author": "Filip Stanis (https://github.com/fstanis)",
  "homepage": "https://garmin-manager.apps.stanis.me/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fstanis/garmin-manager.git"
  },
  "bugs": {
    "url": "https://github.com/fstanis/garmin-manager/issues"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot ./src/index.html",
    "build": "bun build ./src/index.html --minify --target browser --outdir ./dist && cp -r assets dist/",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsmediatags": "^3.9.6",
    "@types/w3c-web-usb": "^1.0.14",
    "typescript": "^7"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "hiq": "^4.2.11",
    "jsmediatags": "^3.9.7",
    "libmtp-web": "^0.1.3",
    "preact": "^10.29.8"
  },
  "patchedDependencies": {
    "hiq@4.2.11": "patches/hiq@4.2.11.patch"
  }
}
